# Copy to `frontend/.env.local` (same folder). Vite loads it automatically; never commit `.env.local`.
#
# Supabase — same project as the API (local `supabase start` or remote dashboard)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-start

# Leave unset for local dev — Vite proxies `/api` and `/health` to localhost:3001
# VITE_API_URL=https://your-api.vercel.app
