# Copy to `.env.local` at the repository root. Never commit `.env.local`.
#
# Local dev: Docker Postgres + Supabase CLI (or remote Supabase project).
#
# 1) cp .env.local.example .env.local
# 2) pnpm docker:up          # optional if using Supabase local Postgres instead
# 3) pnpm migrate:deploy
# 4) pnpm dev:local

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Postgres — Docker Compose (port 5433) or `supabase start` (port 54322)
DATABASE_URL=postgresql://forge:forge@localhost:5433/cardgoose
DIRECT_URL=postgresql://forge:forge@localhost:5433/cardgoose

# Supabase Auth — local via `supabase start` or your remote project dashboard
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-start

# Cloudflare R2 — create bucket `cardgoose` + API token in Cloudflare dashboard
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=cardgoose

# Optional CORS — comma-separated origins; unset allows all in dev
# CORS_ORIGIN=http://localhost:5173

# Frontend env lives in frontend/.env.local (see frontend/.env.local.example)
